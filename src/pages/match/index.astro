---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MatchCard from '../../components/MatchCard.astro';
import { resolveFrom } from '../../lib/recommend';
import { withBase } from '../../lib/url';

const entries = await getCollection('entries');
// 공개 근거가 없는 추천은 빼고, 적합도 높은 순
const items = (await getCollection('matches'))
  .filter((x) => resolveFrom(x.data.from, entries).length > 0)
  .sort((a, b) => b.data.score - a.data.score);
---

<Base title="관심 분야와 맞는 기회" description="내 기록과 맞닿는 DGIST 연구실·기업·인턴">
  <div class="list-page container">
    <header class="lp-head">
      <p class="lp-eyebrow">MATCH</p>
      <h1>관심 분야와 맞는 기회</h1>
      <p class="lp-lead">내 기록과 맞닿는 연구실·기업·인턴이에요. 인턴의 모집 상태는 적합도와 따로 표시해요.</p>
      <a class="lp-link" href={withBase('plan/')}>내 공부 계획 보기 <span aria-hidden="true">→</span></a>
    </header>

    {
      items.length === 0 ? (
        <p class="lp-empty">아직 추천이 없어요. 기록이 쌓이면 AI가 맞는 기회를 찾아 줘요.</p>
      ) : (
        <div class="lp-grid">
          {items.map((item) => (
            <MatchCard item={item} entries={entries} />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .list-page {
    padding-block: clamp(2rem, 6vw, 4.5rem) 6rem;
  }
  .lp-head {
    margin-bottom: 2.5rem;
  }
  .lp-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .lp-lead {
    margin-top: 0.75rem;
    color: var(--muted);
    max-width: 38rem;
  }
  .lp-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--accent);
  }
  .lp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .lp-empty {
    color: var(--muted);
    padding: 3rem 0;
  }
</style>
