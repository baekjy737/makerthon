---
// 내 공부 계획: 모든 추천 카드를 그려 두고, 브라우저에서 localStorage `plan`에 담긴 것만 보여 준다.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextCard from '../../components/NextCard.astro';
import MatchCard from '../../components/MatchCard.astro';
import { resolveFrom } from '../../lib/recommend';
import { withBase } from '../../lib/url';

const entries = await getCollection('entries');
const grounded = <T extends { data: { from: string[] } }>(xs: T[]) => xs.filter((x) => resolveFrom(x.data.from, entries).length > 0);
const nexts = grounded(await getCollection('next'));
const matches = grounded(await getCollection('matches'));
---

<Base title="내 공부 계획" description="추천에서 담아 둔 다음 공부와 기회" noindex>
  <div class="plan-page container">
    <header class="pp-head">
      <p class="pp-eyebrow">PLAN</p>
      <h1>내 공부 계획</h1>
      <p class="pp-lead">추천 카드에서 [계획에 담기]한 것들이에요. 이 브라우저에만 저장돼요.</p>
    </header>

    <p class="pp-msg" data-plan-blocked hidden>이 브라우저에는 저장할 수 없어요. 시크릿 창이거나 사이트 데이터 저장이 막혀 있어요.</p>
    <div class="pp-msg pp-empty" data-plan-empty hidden>
      <p>아직 담은 공부가 없어요.</p>
      <p class="pp-links">
        <a href={withBase('next/')}>다음에 할 공부 보기 <span aria-hidden="true">→</span></a>
        <a href={withBase('match/')}>맞는 기회 보기 <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <noscript><p class="pp-msg">공부 계획을 보려면 자바스크립트를 켜 주세요.</p></noscript>

    <section class="pp-section" data-plan-section hidden aria-labelledby="pp-next">
      <h2 id="pp-next">다음에 할 공부 <span class="count" data-plan-count></span></h2>
      <div class="pp-grid">
        {
          nexts.map((item) => (
            <div class="pp-slot" data-plan-slot={`next:${item.id}`} hidden>
              <NextCard item={item} entries={entries} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="pp-section" data-plan-section hidden aria-labelledby="pp-match">
      <h2 id="pp-match">관심 분야와 맞는 기회 <span class="count" data-plan-count></span></h2>
      <div class="pp-grid">
        {
          matches.map((item) => (
            <div class="pp-slot" data-plan-slot={`match:${item.id}`} hidden>
              <MatchCard item={item} entries={entries} />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<script>
  import { planStore } from '../../lib/plan';

  let storage: Storage | null = null;
  try {
    storage = window.localStorage;
  } catch {
    storage = null;
  }
  const store = planStore(storage);

  const blocked = document.querySelector<HTMLElement>('[data-plan-blocked]')!;
  const empty = document.querySelector<HTMLElement>('[data-plan-empty]')!;

  function render() {
    if (!store.ok) {
      blocked.hidden = false;
      return;
    }
    const saved = new Set(store.list());
    let total = 0;
    document.querySelectorAll<HTMLElement>('[data-plan-section]').forEach((sec) => {
      let n = 0;
      sec.querySelectorAll<HTMLElement>('[data-plan-slot]').forEach((slot) => {
        const on = saved.has(slot.dataset.planSlot!);
        slot.hidden = !on;
        if (on) n += 1;
      });
      sec.hidden = n === 0;
      const count = sec.querySelector('[data-plan-count]');
      if (count) count.textContent = String(n);
      total += n;
    });
    empty.hidden = total > 0;
  }

  document.addEventListener('plan:change', render);
  render();
</script>

<style>
  .plan-page {
    padding-block: clamp(2rem, 6vw, 4.5rem) 6rem;
  }
  .pp-head {
    margin-bottom: 2.5rem;
  }
  .pp-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .pp-lead {
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .pp-msg {
    padding: 2.5rem 0;
    color: var(--muted);
  }
  .pp-msg[hidden],
  .pp-section[hidden],
  .pp-slot[hidden] {
    display: none;
  }
  .pp-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .pp-links a {
    color: var(--accent);
  }
  .pp-section + .pp-section {
    margin-top: 3.5rem;
  }
  .pp-section h2 {
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    margin-left: 0.25rem;
  }
  .pp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
</style>
