---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatStrip from '../components/StatStrip.astro';
import EntryCard from '../components/EntryCard.astro';
import { publicOnly, sortByDate } from '../lib/entries';
import { loadProfile } from '../lib/profile';
import { archiveStats } from '../lib/stats';
import { withBase } from '../lib/url';

const GRADUATION_URL = 'https://my.dgist.ac.kr/com/portal/index.do';

const profile = loadProfile();
const entries = await getCollection('entries');
const stats = archiveStats(entries, new Date());
const pub = sortByDate(publicOnly(entries));
const last = pub[0]?.data.date;
const experience = pub.filter(({ data }) => data.type === 'career').map(({ data }) => (
  [data.title, data.org].filter(Boolean).join(' · ')
));

const featured = pub.filter((e) => e.data.featured);
---

<Base>
  <Hero profile={profile} experience={experience}>
    <StatStrip stats={stats} last={last} />
  </Hero>

  <nav class="profile-row" aria-label="바로가기">
    <a class="shortcut" href={withBase('resume/')}>
      <span class="shortcut-title">CV 열기</span>
      <span class="shortcut-sub">웹 이력서 · PDF로 저장</span>
      <span class="shortcut-arrow" aria-hidden="true">→</span>
    </a>
    <a class="shortcut" href={GRADUATION_URL} target="_blank" rel="noopener">
      <span class="shortcut-title">졸업학점 확인<span class="visually-hidden"> (새 탭)</span></span>
      <span class="shortcut-sub">포털 퀵메뉴 → 졸업시뮬레이션</span>
      <span class="shortcut-arrow" aria-hidden="true">↗</span>
    </a>
  </nav>

  <section id="portfolio" class="portfolio" aria-labelledby="portfolio-title">
    <header class="portfolio-head">
      <p class="eyebrow">SELECTED WORK · {featured.length.toString().padStart(2, '0')}</p>
      <h2 id="portfolio-title">PORT<span>FOLIO</span></h2>
    </header>
    {
      featured.length > 0 ? (
        <div class="portfolio-grid">
          {featured.map((entry) => (
            <EntryCard entry={entry} href={withBase(`/portfolio/${entry.id}/`)} />
          ))}
        </div>
      ) : (
        <p class="empty">아직 대표 작업이 없습니다.</p>
      )
    }
    <a class="more" href={withBase('/archive')}>전체 아카이브 보기 <span aria-hidden="true">↗</span></a>
  </section>
</Base>

<style>
  /* 히어로 바로 아래 바로가기 줄 */
  .profile-row {
    width: var(--content);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .shortcut {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 3rem 1.25rem 1.375rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 8%, transparent);
    transition:
      background-color 150ms ease-out,
      transform 100ms ease-out;
  }
  .shortcut:hover {
    background: color-mix(in srgb, var(--fg) 9%, transparent);
  }
  .shortcut:active {
    transform: scale(0.98);
  }

  .shortcut-title {
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .shortcut-sub {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .shortcut-arrow {
    position: absolute;
    top: 50%;
    right: 1.375rem;
    translate: 0 -50%;
    color: var(--accent);
    font-size: 1.125rem;
  }

  .portfolio {
    width: var(--content);
    margin-inline: auto;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(5rem, 10vw, 8rem);
    scroll-margin-top: 4rem;
  }
  .portfolio-head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }
  .portfolio h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }
  .portfolio h2 span {
    color: var(--muted);
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
  .more {
    display: inline-block;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    color: var(--accent);
    font-family: var(--font-ko-bold);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .profile-row {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shortcut:active {
      transform: none;
    }
  }

  @media (prefers-contrast: more) {
    .shortcut {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }
</style>
