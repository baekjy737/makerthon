---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecommendPreview from '../../components/RecommendPreview.astro';
import { issueUrl } from '../../lib/issue';
import { loadProfile } from '../../lib/profile';
import { withBase } from '../../lib/url';

const applications = await getCollection('applications');
applications.sort((a, b) => b.data.created.getTime() - a.data.created.getTime());
const profile = loadProfile();

// 버튼 본문은 각 이슈 템플릿(.github/ISSUE_TEMPLATE/*.yml)이 만드는 본문과 같은 틀로 맞춘다.
const actions = [
  {
    label: '기록하기',
    plus: true,
    url: issueUrl(profile.repo, {
      label: 'archive',
      title: '[기록] ',
      body: '### 활동 메모\n\n(활동 시기, 맡은 역할, 한 일을 기억나는 만큼 적어 주세요. 이미지나 PDF는 이 칸에 끌어다 놓으면 첨부돼요.)\n\n### 관련 링크\n\n(GitHub 저장소, 발표 자료 등 활동을 확인할 수 있는 주소를 한 줄에 하나씩 적어 주세요.)\n',
    }),
  },
  {
    label: '공고 분석',
    url: issueUrl(profile.repo, {
      label: 'job',
      title: '[공고] ',
      body: '### 공고 본문 또는 링크\n\n(공고 본문을 붙여 넣거나 공고 주소를 적어 주세요. 자소서 문항이 있다면 함께 적어 주세요.)\n\n### 지원 직무\n\n',
    }),
  },
  {
    label: '자소서 쓰기',
    url: issueUrl(profile.repo, {
      label: 'essay',
      title: '[자소서] ',
      body: '### 지원처\n\n(회사나 기관 이름과 직무)\n\n### 자소서 문항\n\n(답변하려는 문항 하나를 원문 그대로 붙여 넣어 주세요.)\n\n### 글자 수 제한\n\n(공백 포함 최대 글자 수. 없으면 비워 두세요.)\n',
    }),
  },
  {
    label: '추천 받기',
    url: issueUrl(profile.repo, {
      label: 'recommend',
      title: '[추천] 다음 공부와 진로',
      body: '### 특히 알고 싶은 분야\n\n(비워 두면 프로필의 관심사와 공개 기록을 바탕으로 추천합니다.)\n',
    }),
  },
];

---

<Base title="지원">
  <section class="container applications" aria-labelledby="applications-title">
    <h1 id="applications-title">지원</h1>
    <div class="actions">
      {
        actions.map((a, i) => (
          <a class:list={['action', { primary: i === 0 }]} href={a.url} target="_blank" rel="noopener">
            {a.plus && <span class="plus" aria-hidden="true">+</span>}
            {a.label}
            <span class="visually-hidden">(GitHub 이슈 작성 화면이 새 탭으로 열려요)</span>
          </a>
        ))
      }
    </div>
    {applications.length ? (
      <ul>
        {applications.map(({ id, data }) => {
          const deadline = data.deadline?.toISOString().slice(0, 10);
          return (
            <li>
              <a href={withBase(`apply/${id}/`)}>
                <div>
                  <p class="company">{data.company}</p>
                  <h2>{data.position}</h2>
                </div>
                <p class="deadline">
                  {deadline ? <>마감 <time datetime={deadline}>{deadline}</time></> : '마감일 미정'}
                  <span aria-hidden="true"> →</span>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    ) : <p>아직 등록된 지원 건이 없습니다.</p>}
  </section>
  <RecommendPreview />
</Base>

<style>
  .applications {
    max-width: 64rem;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    font-size: clamp(2.75rem, 8vw, 5rem);
    letter-spacing: -0.045em;
  }

  .actions {
    display: flex;
    margin-bottom: clamp(2rem, 5vw, 3rem);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
    font-size: 0.9375rem;
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .action:hover {
    border-color: color-mix(in srgb, var(--fg) 40%, transparent);
  }
  .action.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-family: var(--font-ko-bold);
  }
  .action:active {
    transform: scale(0.97);
  }
  .plus {
    margin-right: 0.3em;
  }

  ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li > a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: clamp(1.1rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
    border-radius: 0.75rem;
  }

  li > a:hover,
  li > a:active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  h2 {
    margin-top: 0.25rem;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
  }

  .company,
  .deadline {
    color: var(--muted);
  }

  .deadline span {
    margin-left: 0.5rem;
    color: var(--fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .action:active {
      transform: none;
    }
  }
</style>
