---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpeningCard from '../../components/OpeningCard.astro';
import { boardGroups } from '../../lib/board';
import { interns } from '../../lib/data';
import { issueUrl } from '../../lib/issue';
import { loadOpenings, researchPrograms } from '../../lib/openings';
import { loadProfile } from '../../lib/profile';
import { withBase } from '../../lib/url';

const applications = await getCollection('applications');
applications.sort((a, b) => b.data.created.getTime() - a.data.created.getTime());
const profile = loadProfile();

// 모집 공고: content/openings + data/interns.json + data/research-internships.json.
// 상태는 빌드 시점 기준(페이지에서 방문일 기준으로 다시 계산)
const now = new Date();
const groups = boardGroups(loadOpenings(await getCollection('openings'), interns, researchPrograms), now);
const initial = groups.find((g) => g.active.length > 0) ?? groups.find((g) => g.closed.length > 0) ?? groups[0];

// 버튼 본문은 각 이슈 템플릿(.github/ISSUE_TEMPLATE/*.yml)이 만드는 본문과 같은 틀로 맞춘다.
const actions = [
  {
    label: '기록하기',
    plus: true,
    url: issueUrl(profile.repo, {
      label: 'archive',
      title: '[기록] ',
      body: '### 활동 메모\n\n(활동 시기, 맡은 역할, 한 일을 기억나는 만큼 적어 주세요. 이미지나 PDF는 이 칸에 끌어다 놓으면 첨부돼요.)\n\n### 관련 링크\n\n(GitHub 저장소, 발표 자료 등 활동을 확인할 수 있는 주소를 한 줄에 하나씩 적어 주세요.)\n',
    }),
  },
  {
    label: '공고 추가',
    url: issueUrl(profile.repo, {
      label: 'opening',
      title: '[공고] ',
      body: '### 공고 URL\n\n(모집 공고 주소를 적어 주세요. AI가 원문을 읽고 기관·모집 대상·자격 요건·접수 기간을 정리해요.)\n\n### 공고 유형\n\n(대학원 연구실 인턴 / 연구과제 학부연구생 / 기업 인턴 / 기업 채용 중 하나. 모르면 비워 두세요.)\n\n### 메모\n\n(관심 있는 이유나 확인하고 싶은 점이 있으면 적어 주세요.)\n',
    }),
  },
  {
    label: '지원서 올리기',
    url: issueUrl(profile.repo, {
      label: 'essay',
      title: '[자소서] ',
      body: '### 지원처\n\n(회사나 기관 이름과 직무)\n\n### 지원서 양식 파일(PDF·이미지) 또는 문항 원문\n\n(문항 원문을 붙여 넣거나, 지원서 양식 파일(PDF·이미지)을 이 칸에 끌어다 놓아 주세요.)\n\n### 공통 글자 수 제한 (선택)\n\n(공백 포함 최대 글자 수. 없으면 비워 두세요.)\n',
    }),
  },
];
---

<Base title="지원">
  <div class="container apply">
    <header class="apply-head">
      <h1>지원</h1>
      <p class="lead">지금 지원할 곳을 찾고, 아카이브의 기록을 근거로 지원서를 준비해요.</p>
      <div class="actions">
        {
          actions.map((a, i) => (
            <a class:list={['action', { primary: i === 0 }]} href={a.url} target="_blank" rel="noopener">
              {a.plus && <span class="plus" aria-hidden="true">+</span>}
              {a.label}
              <span class="visually-hidden">(GitHub 이슈 작성 화면이 새 탭으로 열려요)</span>
            </a>
          ))
        }
      </div>
    </header>

    <section class="board" aria-labelledby="board-title">
      <div class="board-head">
        <h2 id="board-title">모집 중인 기회</h2>
        <button type="button" class="switch" role="switch" aria-checked="false" data-open-only>
          <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          모집 중만 보기
        </button>
      </div>

      <div class="tablist-wrap">
        <div class="tablist" role="tablist" aria-label="공고 유형" data-tablist>
          <span class="tab-pill" aria-hidden="true" data-tab-pill></span>
          {
            groups.map((g) => (
              <button
                type="button"
                role="tab"
                class="tab"
                id={`tab-${g.kind}`}
                aria-controls={`tabpanel-${g.kind}`}
                aria-selected={g === initial ? 'true' : 'false'}
                tabindex={g === initial ? 0 : -1}
              >
                {g.label}
                <span class="tab-count" data-tab-count>
                  {g.active.length}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      {
        groups.map((g) => (
          <div
            class="tabpanel"
            role="tabpanel"
            id={`tabpanel-${g.kind}`}
            aria-labelledby={`tab-${g.kind}`}
            hidden={g !== initial}
            data-panel
          >
            <div class="grid" data-active>
              {g.active.map((item) => (
                <OpeningCard item={item} now={now} />
              ))}
            </div>
            <p class="empty" data-empty hidden={g.active.length > 0}>
              <span data-empty-all>아직 모은 {g.label} 공고가 없어요.</span>
              <span data-empty-open hidden>
                지금 모집 중인 {g.label} 공고가 없어요.
              </span>{' '}
              [공고 추가]로 공고 주소를 올리면 AI가 정리해 여기에 더해요.
            </p>
            <details class="closed" data-closed hidden={g.closed.length === 0}>
              <summary>
                마감된 공고 <span data-closed-count>{g.closed.length}</span>개
              </summary>
              <div class="grid">
                {g.closed.map((item) => (
                  <OpeningCard item={item} now={now} />
                ))}
              </div>
            </details>
          </div>
        ))
      }
    </section>

    <section class="mine" aria-labelledby="mine-title">
      <h2 id="mine-title">내 지원서</h2>
      {
        applications.length ? (
          <ul class="app-list">
            {applications.map(({ id, data }) => {
              const deadline = data.deadline?.toISOString().slice(0, 10);
              return (
                <li>
                  <a href={withBase(`apply/${id}/`)}>
                    <div>
                      <p class="company">{data.company}</p>
                      <h3>{data.position}</h3>
                    </div>
                    <p class="deadline">
                      {deadline ? (
                        <>
                          마감 <time datetime={deadline}>{deadline}</time>
                        </>
                      ) : (
                        '마감일 미정'
                      )}
                      <span aria-hidden="true"> →</span>
                    </p>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">아직 등록된 지원 건이 없습니다.</p>
        )
      }
    </section>
  </div>
</Base>

<script>
  import { animate } from 'motion';
  import { daysLeft, ddayLabel } from '../../lib/board';
  import { OPENING_STATUS_LABELS, openingStatus, type Opening } from '../../lib/openings';

  // 1) 빌드 뒤 날짜가 지났을 수 있으니 상태·D-n을 방문한 날 기준으로 다시 계산한다.
  //    모집 중·확인 필요였다가 마감된 카드는 "마감된 공고" 묶음 맨 앞으로 옮긴다.
  const now = new Date();
  const dayOrUndef = (s?: string) => (s ? new Date(`${s}T00:00:00Z`) : undefined);
  for (const card of document.querySelectorAll<HTMLElement>('[data-opening]')) {
    const { verified, hasUrl, start, deadline } = card.dataset;
    const o = {
      verified: verified === '1',
      url: hasUrl === '1' ? 'x' : '',
      start: dayOrUndef(start),
      deadline: dayOrUndef(deadline),
    } as Opening;
    const status = openingStatus(o, now);
    if (status !== card.dataset.status) {
      card.dataset.status = status;
      card.querySelector('[data-badge]')!.textContent = OPENING_STATUS_LABELS[status];
      const panel = card.closest<HTMLElement>('[data-panel]')!;
      const closed = panel.querySelector<HTMLDetailsElement>('[data-closed]')!;
      if (status === 'closed' && !closed.contains(card)) {
        closed.querySelector('.grid')!.prepend(card);
        closed.hidden = false;
      }
    }
    const dd = card.querySelector<HTMLElement>('[data-dday]');
    if (dd && o.deadline) {
      const label = ddayLabel(daysLeft(o.deadline, now));
      dd.textContent = label ?? '';
      dd.hidden = !label;
    }
  }

  // 2) "모집 중만 보기": 모집 중이 아닌 카드와 마감 묶음을 숨기고, 탭 숫자·빈 안내를 맞춘다
  const toggle = document.querySelector<HTMLButtonElement>('[data-open-only]')!;
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const refresh = () => {
    const openOnly = toggle.getAttribute('aria-checked') === 'true';
    for (const panel of panels) {
      const active = [...panel.querySelectorAll<HTMLElement>('[data-active] [data-opening]')];
      let visible = 0;
      for (const card of active) {
        card.hidden = openOnly && card.dataset.status !== 'open';
        if (!card.hidden) visible++;
      }
      const closed = panel.querySelector<HTMLElement>('[data-closed]')!;
      const closedCount = closed.querySelectorAll('[data-opening]').length;
      closed.querySelector('[data-closed-count]')!.textContent = String(closedCount);
      closed.hidden = openOnly || closedCount === 0;
      const empty = panel.querySelector<HTMLElement>('[data-empty]')!;
      empty.hidden = visible > 0;
      empty.querySelector<HTMLElement>('[data-empty-all]')!.hidden = openOnly;
      empty.querySelector<HTMLElement>('[data-empty-open]')!.hidden = !openOnly;
      const tab = document.getElementById(panel.getAttribute('aria-labelledby')!)!;
      tab.querySelector('[data-tab-count]')!.textContent = String(visible);
    }
  };
  toggle.addEventListener('click', () => {
    toggle.setAttribute('aria-checked', String(toggle.getAttribute('aria-checked') !== 'true'));
    refresh();
  });
  refresh();

  // 3) 유형 탭 (archive/index.astro의 tablist와 같은 방식)
  const list = document.querySelector<HTMLElement>('[data-tablist]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const pill = list.querySelector<HTMLElement>('[data-tab-pill]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const SPRING = { type: 'spring', bounce: 0, duration: 0.4 } as const;

    const placePill = (tab: HTMLElement, instant: boolean) => {
      const to = { x: tab.offsetLeft, width: tab.offsetWidth };
      animate(pill, to, instant || reduce.matches ? { duration: 0 } : SPRING);
    };

    const select = (tab: HTMLButtonElement, focus: boolean, instant = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
      placePill(tab, instant);
      // 좁은 화면에서 탭 줄이 가로로 스크롤되므로 고른 탭이 보이게
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: instant || reduce.matches ? 'auto' : 'smooth' });
      if (focus) tab.focus();
    };

    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];

    list.addEventListener('click', (ev) => {
      const tab = (ev.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab, false);
    });

    list.addEventListener('keydown', (ev) => {
      const i = tabs.indexOf(current());
      const next =
        ev.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
        : ev.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
        : ev.key === 'Home' ? tabs[0]
        : ev.key === 'End' ? tabs[tabs.length - 1]
        : null;
      if (!next) return;
      ev.preventDefault();
      select(next, true);
    });

    placePill(current(), true);
    list.classList.add('is-ready');
    new ResizeObserver(() => placePill(current(), true)).observe(list);

    // 4) /apply/#opening-<id>로 들어오면 그 카드가 있는 탭을 열고(마감 묶음이면 펼치고) 보여 준다
    const showTarget = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id.startsWith('opening-')) return;
      const card = document.getElementById(id);
      if (!card) return;
      const panel = card.closest<HTMLElement>('[data-panel]')!;
      const tab = tabs.find((t) => t.getAttribute('aria-controls') === panel.id);
      if (tab) select(tab, false, true);
      // "모집 중만 보기"가 켜져 있으면 모집 중이 아닌 카드(마감 묶음 포함)는 숨어 있으므로 끈다
      if (toggle.getAttribute('aria-checked') === 'true' && card.dataset.status !== 'open') {
        toggle.setAttribute('aria-checked', 'false');
        refresh();
      }
      const closed = card.closest<HTMLDetailsElement>('details');
      if (closed) closed.open = true;
      card.classList.add('is-target');
      card.scrollIntoView({ block: 'center', behavior: reduce.matches ? 'auto' : 'smooth' });
    };
    showTarget();
    addEventListener('hashchange', showTarget);
  }
</script>

<style>
  .apply {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 5rem);
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 0.75rem;
    max-width: 36em;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 4vw, 2rem);
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
    font-size: 0.9375rem;
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .action:hover {
    border-color: color-mix(in srgb, var(--fg) 40%, transparent);
  }
  .action.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-family: var(--font-ko-bold);
  }
  .action:active {
    transform: scale(0.97);
  }
  .plus {
    margin-right: 0.3em;
  }

  /* 모집 공고 보드 */
  .board,
  .mine {
    margin-top: clamp(3rem, 8vw, 5rem);
  }

  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    letter-spacing: -0.02em;
  }

  /* 켜고 끄는 스위치 */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    font-size: 0.9375rem;
    color: var(--fg);
    cursor: pointer;
  }
  .switch-track {
    position: relative;
    width: 2.75rem;
    height: 1.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 18%, transparent);
    transition: background-color 200ms ease-out;
  }
  .switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(1.625rem - 6px);
    height: calc(1.625rem - 6px);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
    transition: transform 250ms cubic-bezier(0.2, 0, 0, 1);
  }
  .switch[aria-checked='true'] .switch-track {
    background: var(--accent);
  }
  .switch[aria-checked='true'] .switch-thumb {
    transform: translateX(1.125rem);
  }

  /* 유형 탭: 좁은 화면에서는 가로로 스크롤 */
  .tablist-wrap {
    margin-top: 1.25rem;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tablist-wrap::-webkit-scrollbar {
    display: none;
  }
  .tablist {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }
  .tab-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    border-radius: 999px;
    background: var(--fg);
    opacity: 0;
  }
  .tablist.is-ready .tab-pill {
    opacity: 1;
  }
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1.125rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 0.9375rem;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 150ms ease-out,
      transform 100ms ease-out;
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab[aria-selected='true'] {
    color: var(--bg);
  }
  .tablist:not(.is-ready) .tab[aria-selected='true'] {
    background: var(--fg);
  }
  .tab:active {
    transform: scale(0.97);
  }
  .tab-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .tabpanel {
    padding-top: 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 0.875rem;
  }
  .grid:empty {
    display: none;
  }

  .empty {
    padding: 1.5rem 0;
    color: var(--muted);
  }

  .closed {
    margin-top: 1.5rem;
  }
  .closed > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .closed > summary::-webkit-details-marker {
    display: none;
  }
  .closed > summary::before {
    content: '›';
    display: inline-block;
    width: 1rem;
    font-size: 1.125rem;
    transition: transform 200ms ease-out;
  }
  .closed[open] > summary::before {
    transform: rotate(90deg);
  }
  .closed > summary:hover {
    color: var(--fg);
  }
  .closed .grid {
    margin-top: 0.75rem;
  }

  /* 내 지원서 */
  .mine h2 {
    margin-bottom: 1.25rem;
  }

  .app-list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .app-list li > a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: clamp(1.1rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
    border-radius: 0.75rem;
  }

  .app-list li > a:hover,
  .app-list li > a:active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  .app-list h3 {
    margin-top: 0.25rem;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
  }

  .company,
  .deadline {
    color: var(--muted);
  }

  .deadline span {
    margin-left: 0.5rem;
    color: var(--fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .action:active,
    .tab:active {
      transform: none;
    }
    .switch-thumb,
    .closed > summary::before {
      transition: none;
    }
  }

  @media (prefers-contrast: more) {
    .tablist {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
    .switch-track {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }
</style>
