---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EssayWorkspace, { type WorkspaceQuestion } from '../../components/EssayWorkspace.astro';
import { essayNumber } from '../../lib/essay';
import { loadProfile } from '../../lib/profile';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  return (await getCollection('applications')).map((application) => ({
    params: { app: application.id },
    props: { application },
  }));
}

interface Props {
  application: CollectionEntry<'applications'>;
}

const { application } = Astro.props;
const { id, data } = application;
const entries = await getCollection('entries');
const entriesById = new Map(entries.map((entry) => [entry.id, entry]));
const matches = data.matches.flatMap((match) => {
  const entry = entriesById.get(match.entry);
  return entry?.data.public ? [{ match, entry }] : [];
}).sort((a, b) => b.match.score - a.match.score);
const privateMatches = data.matches.filter((match) => entriesById.get(match.entry)?.data.public === false);
const essays = await getCollection('essays', (essay) => (
  essay.id.startsWith(`${id}/`) &&
  essay.data.entries.every((entryId) => entriesById.get(entryId)?.data.public === true)
));
essays.sort((a, b) => a.id.localeCompare(b.id, 'ko', { numeric: true }));
// 문항별 작성 화면 데이터. 소재는 공개 항목만 쓴다(비공개 항목은 제목·초안 모두 내보내지 않는다).
// 소재가 없는 문항은 본문을 초안으로 쓴다.
const profile = loadProfile();
const questions: WorkspaceQuestion[] = essays.map((essay) => {
  const materials = essay.data.materials.flatMap((m) => {
    const entry = entriesById.get(m.entry);
    if (!entry?.data.public) return [];
    return [{ entry: entry.id, title: entry.data.title, reason: m.reason, href: withBase(`portfolio/${entry.id}/`), draft: m.draft }];
  });
  return {
    n: essayNumber(essay.id),
    question: essay.data.question,
    limit: essay.data.limit,
    checks: essay.data.checks,
    materials: materials.length > 0 ? materials : [{ entry: '_body', title: '초안', draft: (essay.body ?? '').trim() }],
  };
});
const deadline = data.deadline?.toISOString().slice(0, 10);
const postingUrl = /^https?:\/\//i.test(data.url ?? '') ? data.url : undefined;
---

<Base title={`${data.company} · ${data.position}`}>
  <article class="container application">
    <header class="application-heading">
      <a class="back" href={withBase('apply/')}>← 지원 목록</a>
      <p class="company">{data.company}</p>
      <h1>{data.position}</h1>
      <p class="deadline">
        {deadline ? <>마감 <time datetime={deadline}>{deadline}</time></> : '마감일 미정'}
      </p>
      <div class="actions">
        <a class="resume-link" href={withBase(`resume/${id}/`)}>맞춤 이력서 보기 <span aria-hidden="true">→</span></a>
        {postingUrl && <a class="posting-link" href={postingUrl}>공고 원문 <span aria-hidden="true">↗</span></a>}
      </div>
    </header>

    <div class="analysis">
      <section aria-labelledby="requirements">
        <h2 id="requirements">요구 역량</h2>
        {data.requirements.length
          ? <ul>{data.requirements.map((requirement) => <li>{requirement}</li>)}</ul>
          : <p class="empty">등록된 요구 역량이 없습니다.</p>}
      </section>
      <section aria-labelledby="gaps">
        <h2 id="gaps">보완할 점</h2>
        {data.gaps.length
          ? <ul>{data.gaps.map((gap) => <li>{gap}</li>)}</ul>
          : <p class="empty">등록된 보완 항목이 없습니다.</p>}
      </section>
    </div>

    <section class="match-section" aria-labelledby="matches">
      <h2 id="matches">관련 기록</h2>
      {matches.length || privateMatches.length ? (
        <ul class="match-list">
          {matches.map(({ match, entry }) => (
            <li>
              <div class="match-heading">
                <h3><a href={withBase(`portfolio/${entry.id}/`)}>{entry.data.title}</a></h3>
                <span class="score">{match.score}점</span>
              </div>
              <meter min="0" max="100" value={match.score} aria-label={`${entry.data.title} 적합도`}></meter>
              <p>{match.reason}</p>
            </li>
          ))}
          {privateMatches.map(() => <li class="empty">비공개 항목</li>)}
        </ul>
      ) : <p class="empty">등록된 관련 기록이 없습니다.</p>}
    </section>

    <section class="draft-section" aria-labelledby="drafts">
      <h2 id="drafts">지원서 작성</h2>
      <p class="draft-lead">문항마다 추천 소재를 고르면 그 소재로 쓴 초안이 편집 칸에 떠요. 고친 내용은 이 브라우저에 소재별로 저장돼요.</p>
      {questions.length
        ? <EssayWorkspace app={id} company={data.company} position={data.position} repo={profile.repo} questions={questions} />
        : <p class="empty">표시할 자소서 문항이 없습니다. 지원서를 올리면 AI가 문항과 초안을 정리해요.</p>}
    </section>
  </article>
</Base>

<style>
  .application {
    --rule: color-mix(in srgb, var(--fg) 18%, var(--bg));
    --surface: color-mix(in srgb, var(--fg) 5%, var(--bg));
    --secondary: color-mix(in srgb, var(--fg) 24%, var(--muted));
    max-width: 64rem;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 6vw, 5rem);
  }

  .application-heading {
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }

  .back,
  .company,
  .deadline,
  .empty {
    color: var(--secondary);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  .company {
    margin-top: clamp(0.65rem, 2vw, 1.4rem);
    font-size: 1rem;
  }

  h1 {
    margin-top: 0.25rem;
    max-width: 19ch;
    font-size: clamp(2rem, 3.5vw + 0.85rem, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .deadline {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .actions {
    margin-top: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.95rem;
    border-radius: 2rem;
  }

  .resume-link {
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, var(--bg));
    font-family: var(--font-ko-bold);
  }

  .actions a:hover,
  .actions a:active {
    background: color-mix(in srgb, var(--accent) 25%, var(--bg));
  }

  a {
    text-underline-offset: 0.22em;
  }

  .back:hover,
  .match-heading a {
    text-decoration: underline;
  }

  .analysis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--rule);
    border-radius: 0.875rem;
    background: var(--surface);
  }

  .analysis section {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .analysis section + section {
    border-inline-start: 1px solid var(--rule);
  }

  .analysis h2 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
  }

  .analysis ul {
    padding-inline-start: 1.2em;
    margin: 0;
  }

  .analysis li + li {
    margin-top: 0.35rem;
  }

  h2 {
    margin-bottom: 0.9rem;
    font-size: 1.5rem;
  }

  h3 {
    font-size: 1.075rem;
  }

  .match-section,
  .draft-section {
    margin-top: 2.5rem;
  }

  .match-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .match-list li {
    border-top: 1px solid var(--rule);
    padding-block: 1rem;
  }

  .match-list li p {
    max-width: 60ch;
    color: var(--secondary);
  }

  .match-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 42rem;
  }

  .score {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  meter {
    display: block;
    width: min(100%, 42rem);
    height: 0.75rem;
    margin-block: 0.5rem;
    accent-color: var(--accent);
  }

  meter::-webkit-meter-bar {
    border: 1px solid var(--rule);
    border-radius: 2rem;
    background: var(--surface);
  }

  meter::-webkit-meter-optimum-value {
    border-radius: 2rem;
    background: var(--accent);
  }

  .draft-lead {
    margin: -0.25rem 0 1.5rem;
    max-width: 60ch;
    color: var(--secondary);
  }

  @media (max-width: 38rem) {
    .analysis {
      grid-template-columns: 1fr;
    }

    .analysis section + section {
      border-inline-start: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
