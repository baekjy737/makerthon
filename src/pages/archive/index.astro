---
import { getCollection } from 'astro:content';
import EntryCard from '../../components/EntryCard.astro';
import TypeFilter from '../../components/TypeFilter.astro';
import Base from '../../layouts/Base.astro';
import { publicOnly, sortByDate } from '../../lib/entries';
import { groupByTopic } from '../../lib/study';
import { ENTRY_TYPES } from '../../lib/types';
import { issueUrl } from '../../lib/issue';
import { loadProfile } from '../../lib/profile';
import { withBase } from '../../lib/url';

const profile = loadProfile();
// 공부 기록 탭의 소제목. research(연구/논문)는 활동이 아니라 여기 '연구'로 간다.
const STUDY_SECTIONS = [
  { label: '연구', types: ['research', 'paper'] },
  { label: '공부', types: ['course', 'study'] },
] as const;
const studyTypes: readonly string[] = STUDY_SECTIONS.flatMap((s) => s.types);
const all = sortByDate(publicOnly(await getCollection('entries')));
const isStudy = (type: string) => studyTypes.includes(type);
const entries = all.filter((entry) => !isStudy(entry.data.type));
const studySections = STUDY_SECTIONS.map((s) => ({
  label: s.label,
  groups: groupByTopic(all.filter((entry) => (s.types as readonly string[]).includes(entry.data.type))),
})).filter((s) => s.groups.length > 0);
const studyCount = all.length - entries.length;
const cardHref = (id: string) => withBase(`/portfolio/${id}/?from=archive`);
const uploadUrl = issueUrl(profile.repo, {
  label: 'archive',
  title: '[기록] ',
  body: '### 활동 메모\n\n(활동 시기, 맡은 역할, 한 일을 적어 주세요. 이미지·PDF는 이 칸에 끌어다 놓으면 첨부돼요.)\n\n### 관련 링크\n\n',
});
const tabs = [
  { key: 'activity', label: '활동', count: entries.length },
  { key: 'study', label: '공부 기록', count: studyCount },
] as const;
const availableTypes = ENTRY_TYPES.filter((type) => !isStudy(type) && entries.some((entry) => entry.data.type === type));
const byYear = entries.reduce((groups, entry) => {
  const year = entry.data.date.getFullYear();
  const group = groups.get(year) ?? [];
  group.push(entry);
  groups.set(year, group);
  return groups;
}, new Map<number, typeof entries>());
const yearGroups = Array.from(byYear, ([year, items]) => ({ year, items }));
---

<Base title="아카이브" description="활동과 성장을 시간순으로 모은 공개 기록입니다.">
  <div class="archive container">
    <header class="page-header">
      <p class="eyebrow">ARCHIVE · {entries.length.toString().padStart(2, '0')}</p>
      <h1>기록은 쌓이고,<br /><span>방향이 됩니다.</span></h1>
      <p class="lede">프로젝트부터 연구, 수상, 활동까지 공개한 기록을 시간순으로 모았습니다.</p>
      <a class="upload" href={uploadUrl} target="_blank" rel="noopener">
        <span aria-hidden="true">+</span> 파일 올려 기록하기
        <span class="visually-hidden">(GitHub 이슈 작성 화면이 새 탭으로 열려요)</span>
      </a>
    </header>

    <div class="tablist" role="tablist" aria-label="기록 종류" data-tablist>
      <span class="tab-pill" aria-hidden="true" data-tab-pill></span>
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${t.key}`}
            aria-controls={`tabpanel-${t.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {t.label}
            <span class="tab-count">{t.count}</span>
          </button>
        ))
      }
    </div>

    <div class="tabpanel" role="tabpanel" id="tabpanel-activity" aria-labelledby="tab-activity" data-filter-scope>
    <TypeFilter types={availableTypes} />

    {
      yearGroups.length > 0 ? (
        <div class="timeline">
          {yearGroups.map(({ year, items }) => (
            <section class="year" aria-labelledby={`year-${year}`} data-filter-group>
              <div class="year__label">
                <h2 id={`year-${year}`}>{year}</h2>
                <span>{items.length.toString().padStart(2, '0')}</span>
              </div>
              <div class="year__entries">
                {items.map((entry) => (
                  <EntryCard entry={entry} href={cardHref(entry.id)} />
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <p class="empty">아직 공개된 기록이 없습니다.</p>
      )
    }
    </div>

    <div class="tabpanel" role="tabpanel" id="tabpanel-study" aria-labelledby="tab-study" hidden>
      {
        studyCount > 0 ? (
          studySections.map((sec) => (
            <section class="study-section" aria-labelledby={`study-${sec.label}`}>
              <h2 class="study-title" id={`study-${sec.label}`}>{sec.label}</h2>
              <div class="timeline">
                {sec.groups.map((g) => (
                  <section class="year">
                    <div class="year__label">
                      <h3>{g.topic}</h3>
                      <span>{g.items.length.toString().padStart(2, '0')}</span>
                    </div>
                    <div class="year__entries">
                      {g.items.map((entry) => (
                        <EntryCard entry={entry} href={cardHref(entry.id)} />
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </section>
          ))
        ) : (
          <p class="empty">아직 공부 기록이 없어요. 수업·논문·공부자료를 이슈로 남기면 여기에 주제별로 모여요.</p>
        )
      }
    </div>
  </div>
</Base>

<script>
  import { animate } from 'motion';

  const list = document.querySelector<HTMLElement>('[data-tablist]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const pill = list.querySelector<HTMLElement>('[data-tab-pill]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const SPRING = { type: 'spring', bounce: 0, duration: 0.4 } as const;

    // 선택 표시(알약)를 선택된 탭 위치로. 처음과 크기 변경 때는 바로, 탭을 바꿀 때는 스프링으로
    const placePill = (tab: HTMLElement, instant: boolean) => {
      const to = { x: tab.offsetLeft, width: tab.offsetWidth };
      animate(pill, to, instant || reduce.matches ? { duration: 0 } : SPRING);
    };

    const select = (tab: HTMLButtonElement, focus: boolean) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
      placePill(tab, false);
      if (focus) tab.focus();
    };

    const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];

    list.addEventListener('click', (ev) => {
      const tab = (ev.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab, false);
    });

    // 좌우 화살표·Home·End로 탭 이동 (자동 선택)
    list.addEventListener('keydown', (ev) => {
      const i = tabs.indexOf(current());
      const next =
        ev.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
        : ev.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
        : ev.key === 'Home' ? tabs[0]
        : ev.key === 'End' ? tabs[tabs.length - 1]
        : null;
      if (!next) return;
      ev.preventDefault();
      select(next, true);
    });

    placePill(current(), true);
    list.classList.add('is-ready');
    new ResizeObserver(() => placePill(current(), true)).observe(list);
  }
</script>

<style>
  .tablist {
    position: relative;
    display: inline-flex;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
  }
  .tab-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    border-radius: 999px;
    background: var(--fg);
    opacity: 0;
  }
  .tablist.is-ready .tab-pill {
    opacity: 1;
  }
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1.125rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      color 150ms ease-out,
      transform 100ms ease-out;
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab[aria-selected='true'] {
    color: var(--bg);
  }
  /* 스크립트가 알약을 놓기 전에는 선택 탭 자체에 배경 */
  .tablist:not(.is-ready) .tab[aria-selected='true'] {
    background: var(--fg);
  }
  .tab:active {
    transform: scale(0.97);
  }
  .upload {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 1.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 0.9375rem;
    transition: transform 100ms ease-out;
  }
  .upload:active {
    transform: scale(0.97);
  }
  .study-section + .study-section {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .study-title {
    margin-bottom: 1.5rem;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    letter-spacing: -0.02em;
  }
  #tabpanel-study {
    padding-top: clamp(2rem, 6vw, 4rem);
  }
  .tab-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .upload:active,
    .tab:active {
      transform: none;
    }
  }

  .archive {
    padding-block: clamp(4rem, 9vw, 8rem) 8rem;
  }

  .page-header {
    max-width: 56rem;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  h1 span {
    color: var(--muted);
  }

  .lede {
    max-width: 38rem;
    margin-top: 2rem;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .timeline {
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(4.6rem, 10vw, 8.5rem);
    width: 1px;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--muted) 24%, transparent) 18%, transparent);
  }

  .year[hidden] {
    display: none;
  }

  .year {
    display: grid;
    grid-template-columns: clamp(5.5rem, 12vw, 10rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .year__label {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-right: clamp(0.8rem, 2vw, 1.6rem);
  }

  .year__label::after {
    content: '';
    position: absolute;
    top: 0.66rem;
    right: -0.31rem;
    width: 0.65rem;
    aspect-ratio: 1;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .year__label h2,
  .year__label h3 {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    letter-spacing: 0.03em;
  }

  .year__label span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .year__entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty {
    padding: 4rem 0;
    border-top: 1px solid color-mix(in srgb, var(--muted) 28%, transparent);
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .timeline::before {
      left: 0.3rem;
    }

    .year {
      display: block;
      padding-left: 1.75rem;
    }

    .year__label {
      position: relative;
      top: auto;
      justify-content: flex-start;
      margin-bottom: 1rem;
      padding: 0;
    }

    .year__label::after {
      left: -1.75rem;
      right: auto;
    }

    .year__entries {
      grid-template-columns: 1fr;
    }
  }
</style>
