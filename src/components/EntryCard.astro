---
import type { CollectionEntry } from 'astro:content';
import { TYPE_LABELS } from '../lib/types';

interface Props {
  entry: CollectionEntry<'entries'>;
  href?: string;
}

const { entry, href } = Astro.props;
const { data } = entry;
const Element = href ? 'a' : 'article';

const formatMonth = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;

const start = formatMonth(data.date);
const end = data.end ? formatMonth(data.end) : undefined;
const period = end && end !== start ? `${start}–${end}` : start;
const affiliation = [data.org, data.role].filter(Boolean).join(' · ');
---

<Element
  class:list={['entry-card', 'lift-card', { 'entry-card--link': Boolean(href) }]}
  data-type={data.type}
  href={href}
>
  <div class="entry-card__meta">
    <span class="entry-card__type">{TYPE_LABELS[data.type]}</span>
    <time datetime={data.date.toISOString().slice(0, 10)}>{period}</time>
  </div>

  <div class="entry-card__heading">
    <h3>{data.title}</h3>
    {href && <span class="entry-card__arrow" aria-hidden="true">↗</span>}
  </div>

  {affiliation && <p class="entry-card__affiliation">{affiliation}</p>}
  <p class="entry-card__summary">{data.summary}</p>

  {
    data.tags.length > 0 && (
      <ul class="entry-card__tags" aria-label="태그">
        {data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )
  }
</Element>

<style>
  /* display: flex가 hidden 속성을 덮지 않게 (종류 필터) */
  .entry-card[hidden] {
    display: none;
  }

  .entry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.25rem;
    overflow: hidden;
  }

  .entry-card--link:active {
    transform: translateY(-1px) scale(0.99);
  }

  .entry-card__meta,
  .entry-card__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .entry-card__meta {
    margin-bottom: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-card__type {
    color: var(--accent);
    font-family: var(--font-ko-bold);
    font-weight: 700;
    letter-spacing: 0;
  }

  .entry-card__heading {
    align-items: flex-start;
  }

  h3 {
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    line-height: 1.3;
  }

  .entry-card__arrow {
    flex: none;
    color: var(--accent);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 240ms var(--ease-out);
  }

  .entry-card--link:hover .entry-card__arrow {
    transform: translate(2px, -2px);
  }

  .entry-card__affiliation {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .entry-card__summary {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--fg) 82%, var(--muted));
    line-height: 1.65;
  }

  .entry-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: auto 0 0;
    padding: 1.25rem 0 0;
    list-style: none;
  }

  .entry-card__tags li {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-card__arrow {
      transition: none;
    }

    .entry-card--link:active,
    .entry-card--link:hover .entry-card__arrow {
      transform: none;
    }
  }
</style>
