---
import { lastLabel, type ArchiveStats } from '../lib/stats';
import { withBase } from '../lib/url';

interface Props {
  stats: ArchiveStats;
  /** 가장 최근 공개 항목 날짜. 방문할 때 "N일 전"을 다시 계산하는 데 쓴다 */
  last?: Date;
}

const { stats, last } = Astro.props;
---

<div class="strip">
  <ul class="stats" aria-label="기록 통계">
    <li class="live"><span class="dot" aria-hidden="true"></span>기록 <b>{stats.total}</b></li>
    <li>프로젝트 <b>{stats.projects}</b></li>
    <li>수상 <b>{stats.awards}</b></li>
    {
      stats.daysSinceLast !== null && last && (
        <li>
          마지막 기록 <b data-last={last.toISOString()}>{lastLabel(stats.daysSinceLast)}</b>
        </li>
      )
    }
  </ul>

  <div class="actions">
    <a class="btn primary" href={withBase('/resume/#portfolio')}>포트폴리오 보기</a>
    <a class="btn" href={withBase('/resume')}>이력서 PDF</a>
  </div>
</div>

<script>
  // 사이트는 빌드할 때 한 번 만들어지므로, "N일 전"은 방문한 날 기준으로 다시 계산한다.
  import { daysSince, lastLabel } from '../lib/stats';

  for (const el of document.querySelectorAll<HTMLElement>('[data-last]')) {
    const t = Date.parse(el.dataset.last ?? '');
    if (!Number.isNaN(t)) el.textContent = lastLabel(daysSince(t, new Date()));
  }
</script>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* 값은 굵게, 숫자 폭은 고정 ("일 전" 같은 한글이 섞여도 한글 글꼴 유지) */
  .stats b {
    margin-left: 0.4em;
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .live {
    display: inline-flex;
    align-items: center;
  }

  .dot {
    width: 7px;
    height: 7px;
    margin-right: 0.6em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 0.9375rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 28%, transparent);
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out;
  }

  .btn:hover {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  .btn.primary {
    background: var(--fg);
    color: var(--bg);
    box-shadow: none;
  }

  .btn.primary:hover {
    background: color-mix(in srgb, var(--fg) 86%, var(--bg));
  }

  /* 누르는 순간 바로 반응 */
  .btn:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }
  }

  @media (prefers-contrast: more) {
    .btn {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }
</style>
