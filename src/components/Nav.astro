---
import { withBase } from '../lib/url';

interface Props {
  monogram: string;
}

const { monogram } = Astro.props;
const items = [
  { href: '/', label: 'MAIN' },
  { href: '/archive', label: 'ARCHIVE' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/resume', label: 'RESUME' },
  { href: '/recommend', label: 'RECOMMEND' },
  { href: '/apply', label: 'APPLY' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return here === target || (href !== '/' && here.startsWith(target + '/'));
};
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="monogram" href={withBase('/')} aria-label="처음으로">{monogram}</a>
    <nav class="glass-tabs" aria-label="주요 메뉴">
      <ul>
        {items.map(({ href, label }) => (
          <li>
            <a href={withBase(href)} aria-current={isCurrent(href) ? 'page' : undefined}>
              {isCurrent(href) && <span class="tab-indicator" aria-hidden="true"></span>}
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import { animate } from 'motion';

  const tabs = document.querySelector('.glass-tabs');
  const current = tabs?.querySelector<HTMLAnchorElement>('[aria-current="page"]');
  const indicator = current?.querySelector<HTMLElement>('.tab-indicator');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const storageKey = 'makerthon:tab-slide:' + import.meta.env.BASE_URL;

  if (tabs && current && indicator) {
    try {
      const pending = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null');
      sessionStorage.removeItem(storageKey);
      if (!reducedMotion.matches && pending?.to === window.location.pathname.replace(/\/$/, '')) {
        const previous = Array.from(tabs.querySelectorAll<HTMLAnchorElement>('a'))
          .find((link) => link.pathname === pending.from);
        if (previous && previous !== current) {
          const from = previous.getBoundingClientRect();
          const to = current.getBoundingClientRect();
          animate(indicator, {
            x: [from.left - to.left, 0],
            y: [from.top - to.top, 0],
            scaleX: [from.width / to.width, 1],
          }, { type: 'spring', stiffness: 420, damping: 41, mass: 1 });
        }
      }
    } catch {
      // The active tab is already marked in HTML.
    }

    tabs.addEventListener('click', (event) => {
      if (reducedMotion.matches || event.defaultPrevented || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const next = event.target instanceof Element ? event.target.closest('a') : null;
      if (!next || next === current || next.origin !== location.origin) return;
      try {
        sessionStorage.setItem(storageKey, JSON.stringify({
          from: current.pathname,
          to: next.pathname.replace(/\/$/, ''),
        }));
      } catch {
        // Follow the link normally if browser storage is unavailable.
      }
    });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.75rem;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    width: var(--content);
    margin-inline: auto;
  }

  .glass-tabs {
    --nav-surface: color-mix(in srgb, var(--bg) 96%, var(--fg));
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, var(--bg));
    border-radius: 2rem;
    background: var(--nav-surface);
    box-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--fg) 9%, transparent);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .glass-tabs {
      background: color-mix(in srgb, var(--nav-surface) 84%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(145%);
      backdrop-filter: blur(18px) saturate(145%);
    }
  }

  ul {
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.125rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 1.5rem;
    color: var(--muted);
  }

  .glass-tabs a {
    position: relative;
    justify-content: center;
    padding-inline: clamp(0.5rem, 1.4vw, 1.15rem);
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    white-space: nowrap;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--fg);
  }

  .glass-tabs a:hover {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .tab-indicator {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in srgb, var(--fg) 11%, var(--bg));
    transform-origin: left center;
    pointer-events: none;
  }

  .monogram {
    justify-self: start;
    color: var(--fg);
    font: 700 0.8rem var(--font-mono);
  }

  @media (max-width: 42rem) {
    .nav-inner {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .monogram {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .glass-tabs {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-contrast: more) {
    .glass-tabs {
      border-color: var(--fg);
      box-shadow: none;
    }

    .tab-indicator {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }
</style>
