---
import { withBase } from '../lib/url';

interface Props {
  monogram: string;
}

const { monogram } = Astro.props;
const items = [
  { href: '/', label: 'MAIN' },
  { href: '/archive', label: 'ARCHIVE' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/resume', label: 'RESUME' },
  { href: '/recommend', label: 'RECOMMEND' },
  { href: '/apply', label: 'APPLY' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const recommendationRoutes = ['/recommend', '/match', '/next', '/plan'];
const isCurrent = (href: string) => {
  const routes = href === '/recommend' ? recommendationRoutes : [href];
  return routes.some((route) => {
    const target = withBase(route).replace(/\/$/, '');
    return here === target || (route !== '/' && here.startsWith(target + '/'));
  });
};
const activeItem = items.find(({ href }) => isCurrent(href));
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="monogram" href={withBase('/')} aria-label="처음으로">{monogram}</a>
    <nav class="glass-tabs" aria-label="주요 메뉴">
      <span class="glass-surface" aria-hidden="true"></span>
      <ul id="primary-tab-list">
        {items.map(({ href, label }) => (
          <li>
            <a href={withBase(href)} aria-current={isCurrent(href) ? 'page' : undefined}>
              {isCurrent(href) && <span class="tab-indicator" aria-hidden="true"></span>}
              {label}
            </a>
          </li>
        ))}
      </ul>
      {activeItem && (
        <button class="compact-tab" type="button" aria-controls="primary-tab-list" aria-expanded="false">
          {activeItem.label}
          <span class="visually-hidden"> 전체 메뉴 펼치기</span>
        </button>
      )}
    </nav>
  </div>
</header>

<script>
  import { animate, type AnimationPlaybackControls } from 'motion';

  const spring = { type: 'spring', stiffness: 420, damping: 41, mass: 1 } as const;

  const tabs = document.querySelector<HTMLElement>('.glass-tabs');
  const current = tabs?.querySelector<HTMLAnchorElement>('[aria-current="page"]');
  const indicator = current?.querySelector<HTMLElement>('.tab-indicator');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const storageKey = 'makerthon:tab-slide:' + import.meta.env.BASE_URL;

  if (tabs && current && indicator) {
    try {
      const pending = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null');
      sessionStorage.removeItem(storageKey);
      if (!reducedMotion.matches && pending?.to === window.location.pathname.replace(/\/$/, '')) {
        const previous = Array.from(tabs.querySelectorAll<HTMLAnchorElement>('a'))
          .find((link) => link.pathname === pending.from);
        if (previous && previous !== current) {
          const from = previous.getBoundingClientRect();
          const to = current.getBoundingClientRect();
          animate(indicator, {
            x: [from.left - to.left, 0],
            y: [from.top - to.top, 0],
            scaleX: [from.width / to.width, 1],
          }, spring);
        }
      }
    } catch {
      // The active tab is already marked in HTML.
    }

    tabs.addEventListener('click', (event) => {
      if (reducedMotion.matches || event.defaultPrevented || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const next = event.target instanceof Element ? event.target.closest('a') : null;
      if (!next || next === current || next.origin !== location.origin) return;
      try {
        sessionStorage.setItem(storageKey, JSON.stringify({
          from: current.pathname,
          to: next.pathname.replace(/\/$/, ''),
        }));
      } catch {
        // Follow the link normally if browser storage is unavailable.
      }
    });
  }

  const list = tabs?.querySelector<HTMLUListElement>('ul');
  const compactButton = tabs?.querySelector<HTMLButtonElement>('.compact-tab');
  const surface = tabs?.querySelector<HTMLElement>('.glass-surface');
  if (tabs && list && current && compactButton && surface) {
    let scrollAnchor = Math.max(0, window.scrollY);
    let frame = 0;
    let idleTimer: number | undefined;
    let resizeAnimation: AnimationPlaybackControls | undefined;

    const clearSurfaceSize = () => {
      surface.style.removeProperty('width');
      surface.style.removeProperty('height');
    };

    const setCompact = (compact: boolean) => {
      if (compact === tabs.hasAttribute('data-compact')) return;
      const from = surface.getBoundingClientRect();
      resizeAnimation?.stop();
      clearSurfaceSize();
      const restoreFocus = !compact && document.activeElement === compactButton;
      if (compact) tabs.style.setProperty('--compact-width', (compactButton.offsetWidth + 10) + 'px');
      tabs.toggleAttribute('data-compact', compact);
      list.inert = compact;
      compactButton.setAttribute('aria-expanded', String(!compact));
      if (restoreFocus) current.focus({ preventScroll: true });
      if (!reducedMotion.matches) {
        const to = surface.getBoundingClientRect();
        resizeAnimation = animate(surface, {
          width: [from.width, to.width],
          height: [from.height, to.height],
        }, { ...spring, velocity: 0, onComplete: clearSurfaceSize });
      }
    };

    const updateOnScroll = () => {
      frame = 0;
      const position = Math.max(0, window.scrollY);
      const distance = position - scrollAnchor;
      if (position <= 48 || distance <= -14) {
        setCompact(false);
        scrollAnchor = position;
      } else if (distance >= 20) {
        if (!list.querySelector(':focus-visible')) setCompact(true);
        scrollAnchor = position;
      }
    };

    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(updateOnScroll);
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        scrollAnchor = Math.max(0, window.scrollY);
        setCompact(false);
      }, 180);
    }, { passive: true });

    compactButton.addEventListener('click', () => {
      scrollAnchor = Math.max(0, window.scrollY);
      setCompact(false);
    });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.75rem;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    width: var(--content);
    margin-inline: auto;
  }

  .glass-tabs {
    position: relative;
    isolation: isolate;
    --nav-surface: color-mix(in srgb, var(--bg) 96%, var(--fg));
    padding: calc(0.25rem + 1px);
  }

  .glass-surface {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: var(--compact-width, 0px);
    min-height: calc(2.75rem + 10px);
    max-width: 100%;
    max-height: 100%;
    transform: translate(-50%, -50%);
    z-index: -1;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, var(--bg));
    border-radius: 2rem;
    background: var(--nav-surface);
    box-shadow: 0 0.35rem 1rem color-mix(in srgb, var(--fg) 9%, transparent);
    pointer-events: none;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .glass-surface {
      background: color-mix(in srgb, var(--nav-surface) 84%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(145%);
      backdrop-filter: blur(18px) saturate(145%);
    }
  }

  ul {
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.125rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 1.5rem;
    color: var(--muted);
  }

  .glass-tabs a,
  .compact-tab {
    position: relative;
    justify-content: center;
    padding-inline: clamp(0.5rem, 1.4vw, 1.15rem);
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.035em;
    white-space: nowrap;
  }

  .compact-tab {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border: 0;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--fg) 11%, var(--bg));
    color: var(--fg);
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
  }

  .glass-tabs[data-compact] {
    pointer-events: none;
  }

  .glass-tabs[data-compact] .glass-surface {
    width: var(--compact-width);
    height: calc(2.75rem + 10px);
  }

  .glass-tabs[data-compact] ul {
    opacity: 0;
    visibility: hidden;
  }

  .glass-tabs[data-compact] .compact-tab {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--fg);
  }

  .glass-tabs a:hover {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .tab-indicator {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in srgb, var(--fg) 11%, var(--bg));
    transform-origin: left center;
    pointer-events: none;
  }

  .monogram {
    justify-self: start;
    color: var(--fg);
    font: 700 0.8rem var(--font-mono);
  }

  @media (max-width: 42rem) {
    .nav-inner {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .monogram {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .glass-surface {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-contrast: more) {
    .glass-surface {
      border-color: var(--fg);
      box-shadow: none;
    }

    .tab-indicator,
    .compact-tab {
      box-shadow: inset 0 0 0 1px var(--fg);
    }
  }

</style>
