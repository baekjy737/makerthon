---
// 오른쪽 상세 패널. 페이지에 하나만 둔다.
// 열기: [data-detail-open][data-detail-id="<id>"] 버튼을 누르면
//       <template data-detail="<id>" data-title="제목" data-kicker="종류·기간"> 내용을 복제해 채운다.
// 템플릿 안에서는 .detail-block / .detail-label / .detail-text / .detail-empty / .detail-meta / .detail-link 를 쓸 수 있다.
// 스크림 없음: 패널이 열려 있어도 목록은 계속 조작할 수 있다(MemoPanel과 같은 평행 패널).
---

<aside class="detail" role="dialog" aria-modal="false" aria-labelledby="detail-title" id="detail-panel" data-detail-panel inert>
  <div class="detail-inner">
    <header class="detail-head">
      <div class="detail-meta-head">
        <p class="detail-kicker" data-detail-kicker></p>
        <h2 id="detail-title" tabindex="-1" data-detail-title></h2>
      </div>
      <button type="button" class="detail-close" data-detail-close aria-label="상세 닫기" title="닫기">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>
    <div class="detail-body" data-detail-body></div>
  </div>
</aside>

<script>
  import { animate, type AnimationPlaybackControls } from 'motion';

  const panel = document.querySelector<HTMLElement>('[data-detail-panel]')!;
  const titleEl = panel.querySelector<HTMLElement>('[data-detail-title]')!;
  const kickerEl = panel.querySelector<HTMLElement>('[data-detail-kicker]')!;
  const body = panel.querySelector<HTMLElement>('[data-detail-body]')!;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SPRING = { type: 'spring', bounce: 0, duration: 0.4 } as const;

  let open = false;
  let currentId: string | null = null;
  let trigger: HTMLElement | null = null;
  let anim: AnimationPlaybackControls | null = null;

  // 닫힌 위치를 motion에 먼저 알려 두면, 이후 애니메이션은 항상 현재 화면 위치에서 시작한다(중간에 방향 전환 가능).
  animate(panel, { x: '100%', opacity: 1 }, { duration: 0 });

  function fill(id: string): boolean {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-detail="${CSS.escape(id)}"]`);
    if (!tpl) return false;
    titleEl.textContent = tpl.dataset.title ?? '';
    kickerEl.textContent = tpl.dataset.kicker ?? '';
    kickerEl.hidden = !tpl.dataset.kicker;
    body.replaceChildren(tpl.content.cloneNode(true));
    body.scrollTop = 0;
    currentId = id;
    return true;
  }

  function setTrigger(btn: HTMLElement) {
    trigger?.setAttribute('aria-expanded', 'false');
    trigger = btn;
    btn.setAttribute('aria-expanded', 'true');
  }

  function show() {
    if (open) {
      // 이미 열려 있으면 내용만 바꾸고 살짝 페이드
      if (!reduce.matches) animate(body, { opacity: [0.4, 1] }, { duration: 0.2 });
      return;
    }
    open = true;
    panel.inert = false;
    panel.classList.add('is-open');
    anim?.stop();
    anim = reduce.matches
      ? animate(panel, { x: 0, opacity: [0, 1] }, { duration: 0.2, x: { duration: 0 } })
      : animate(panel, { x: 0, opacity: 1 }, SPRING);
  }

  function hide() {
    if (!open) return;
    open = false;
    panel.inert = true;
    trigger?.setAttribute('aria-expanded', 'false');
    anim?.stop();
    anim = reduce.matches ? animate(panel, { opacity: 0 }, { duration: 0.2 }) : animate(panel, { x: '100%' }, SPRING);
    anim.then(() => {
      // 그 사이 다시 열렸으면 건드리지 않는다
      if (!open) {
        panel.classList.remove('is-open');
        animate(panel, { x: '100%', opacity: 1 }, { duration: 0 });
      }
    });
    trigger?.focus({ preventScroll: true });
    currentId = null;
  }

  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-detail-open][data-detail-id]');
    if (!btn) return;
    const id = btn.dataset.detailId!;
    if (open && currentId === id) {
      hide();
      return;
    }
    if (!fill(id)) return;
    setTrigger(btn);
    show();
    titleEl.focus({ preventScroll: true });
  });

  panel.querySelector('[data-detail-close]')!.addEventListener('click', hide);

  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape' || !open) return;
    ev.preventDefault();
    hide();
  });
</script>

<style>
  .detail {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    width: min(420px, 100vw);
    visibility: hidden;
    transform: translateX(100%);
    will-change: transform;
  }
  .detail.is-open {
    visibility: visible;
  }

  /* 막지 않는 평행 패널: 스크림 없이 반투명 재질 + 그림자로 띄운다 */
  .detail-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: max(1.25rem, env(safe-area-inset-top)) 1.5rem max(1.25rem, env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    border-left: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
    box-shadow: -24px 0 60px -20px rgb(0 0 0 / 0.55);
  }

  .detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .detail-meta-head {
    min-width: 0;
  }

  .detail-kicker {
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .detail-head h2 {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .detail-head h2:focus {
    outline: none;
  }
  .detail-head h2:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .detail-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -0.375rem -0.5rem 0 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    cursor: pointer;
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out;
  }
  .detail-close:hover {
    background: color-mix(in srgb, var(--fg) 14%, transparent);
  }
  .detail-close:active {
    transform: scale(0.94);
  }

  .detail-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* 템플릿 내용용 공통 클래스 (다른 컴포넌트의 템플릿도 쓸 수 있게 :global) */
  .detail-body :global(.detail-block + .detail-block) {
    margin-top: 1.75rem;
  }
  .detail-body :global(.detail-label) {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .detail-body :global(.detail-text) {
    white-space: pre-line;
    line-height: 1.75;
  }
  .detail-body :global(.detail-empty) {
    color: var(--muted);
  }
  .detail-body :global(.detail-meta) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  .detail-body :global(.detail-meta dt) {
    color: var(--muted);
  }
  .detail-body :global(.detail-meta dd) {
    margin: 0;
  }
  .detail-body :global(.detail-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0 1.125rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-ko-bold);
    font-weight: 700;
    font-size: 0.9375rem;
    transition: transform 100ms ease-out;
  }
  .detail-body :global(.detail-link:active) {
    transform: scale(0.97);
  }

  @media (prefers-reduced-transparency: reduce) {
    .detail-inner {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-contrast: more) {
    .detail-inner {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-left-color: var(--fg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .detail-close:active,
    .detail-body :global(.detail-link:active) {
      transform: none;
    }
  }
</style>
