---
import type { Profile } from '../lib/profile';
import { introHtml } from '../lib/intro';
import { withBase } from '../lib/url';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { line1, line2, line3 } = profile.name;
// 셋째 줄의 × 만 포인트색
const line3Parts = line3.split('×');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="visual">
      {
        profile.photo ? (
          <img src={withBase(profile.photo)} alt={profile.name.ko} width="640" height="800" fetchpriority="high" />
        ) : (
          <div class="monogram" aria-hidden="true">
            {profile.monogram}
          </div>
        )
      }
    </div>

    <div class="text">
      <h1 id="hero-title" class="type">
        <span class="visually-hidden">{profile.name.ko} · </span>
        <span class="line" style="--i: 0">{line1}</span>
        <span class="line muted" style="--i: 1">{line2}<span class="dash" aria-hidden="true"></span></span>
        <span class="line" style="--i: 2">
          {line3Parts.map((part, i) => (i === 0 ? part : [<span class="times">×</span>, part]))}
        </span>
      </h1>

      <p class="intro rise" style="--i: 3" set:html={introHtml(profile.intro)} />

      <div class="rise" style="--i: 4">
        <slot />
      </div>
    </div>
  </div>

  <div class="scroll" aria-hidden="true">
    <span class="scroll-label">SCROLL</span>
    <span class="scroll-track"><span class="scroll-fill" data-scroll-fill></span></span>
  </div>
</section>

<script>
  // SCROLL 세로선: 스크롤 진행률을 1:1로 채운다. 반복 애니메이션 없이 스크롤할 때만 그린다.
  // 스크롤할 내용이 없으면 표시 자체를 숨긴다.
  const fill = document.querySelector<HTMLElement>('[data-scroll-fill]');
  const indicator = fill?.closest<HTMLElement>('.scroll');
  if (fill && indicator) {
    let frame = 0;
    const draw = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      indicator.hidden = max <= 0;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      fill.style.transform = `scaleY(${p})`;
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    draw();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    /* 내비 높이를 빼고 첫 화면을 채운다 */
    min-height: calc(100svh - 4rem);
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(4rem, 10vh, 6rem);
  }

  /* 미세 도트 배경. 움직이지 않고 가장자리로 갈수록 사라진다 */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 16%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 55% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 65% at 55% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    width: var(--content);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(220px, 0.75fr) 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* 사진 / 모노그램 */
  .visual {
    animation: materialize 700ms var(--ease-out) both;
  }

  .visual img,
  .monogram {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
  }

  .visual img {
    object-fit: cover;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .monogram {
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  /* 3줄 타이포 */
  .type {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .line {
    display: block;
    animation: rise 600ms var(--ease-out) both;
    animation-delay: calc(100ms + var(--i) * 80ms);
  }

  .muted {
    color: var(--muted);
  }

  .dash {
    display: inline-block;
    width: 0.42em;
    height: 0.09em;
    margin-left: 0.14em;
    vertical-align: 0.34em;
    background: var(--accent);
  }

  /* Anton에는 × 글리프가 없어 대체 글꼴의 굵은 ✖가 나온다. 가는 시스템 글꼴로 맞춘다 */
  .times {
    display: inline-block;
    margin-inline: 0.04em;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-weight: 200;
    font-size: 0.82em;
    vertical-align: 0.04em;
    color: var(--accent);
  }

  .intro {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 34em;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--muted);
  }

  .intro :global(strong) {
    color: var(--fg);
  }

  .rise {
    animation: rise 600ms var(--ease-out) both;
    animation-delay: calc(100ms + var(--i) * 80ms);
  }

  .rise:last-child {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* SCROLL 세로선 */
  .scroll {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(1rem, 3vh, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--muted);
  }

  .scroll[hidden] {
    display: none;
  }

  .scroll-label {
    writing-mode: vertical-rl;
  }

  .scroll-track {
    position: relative;
    width: 1px;
    height: 56px;
    overflow: hidden;
    background: color-mix(in srgb, var(--fg) 16%, transparent);
  }

  .scroll-fill {
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes materialize {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: scale(0.96);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding-block: 2rem 5rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .visual {
      width: min(62%, 280px);
    }
    .type {
      font-size: clamp(3rem, 15vw, 5rem);
    }
    /* 한 열에서는 내용과 겹치므로 숨긴다 */
    .scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .rise,
    .visual {
      animation-name: fade;
      animation-duration: 300ms;
    }
  }
</style>
