---
import type { Lab } from '../lib/data';
import type { Opening, ResearchTopic } from '../lib/openings';
import { normalizeInterest } from '../lib/labMatch';
import { withBase } from '../lib/url';

interface Props {
  lab?: Lab;
  topic?: ResearchTopic;
  hits: string[];
  opening?: Opening;
}

const { lab, topic, hits, opening } = Astro.props;
if (!lab && !topic) throw new Error('LabCard에는 lab 또는 topic이 필요합니다.');
const normalizedHits = new Set(hits.map(normalizeInterest));
const isHit = (value: string) => {
  const normalized = normalizeInterest(value);
  return [...normalizedHits].some((hit) => normalized.includes(hit) || hit.includes(normalized));
};
const org = topic?.org ?? 'DGIST';
const division = topic?.division?.trim();
const title = lab ? (lab.lab ?? lab.name) : (topic?.lab || (topic?.professor ? `${topic.professor} 연구실` : topic?.program));
const subtitle = lab ? `${lab.name} 교수` : [topic?.professor && `${topic.professor} 교수`, topic?.program].filter(Boolean).join(' · ');
const summary = lab?.summary ?? topic?.topic ?? '';
const topicTags = topic ? [topic.category, topic.division, `타교 지원 ${topic.crossSchool}`].filter(Boolean) : [];
---

<article class="lab-card" data-lab-card data-hits={JSON.stringify(hits)} data-org={org}>
  <div class="lab-card__top">
    <p class="lab-card__dept">{topic ? [topic.org, division].filter(Boolean).join(' · ') : lab?.dept}</p>
    {hits.length > 0 && <span class="lab-card__match">관심사 {hits.length}개 일치</span>}
  </div>

  <h3>{title}</h3>
  <p class="lab-card__professor">{subtitle}</p>
  <p class:list={{ 'lab-card__summary': true, matched: !!topic && isHit(summary) }}>{summary}</p>

  {lab && lab.internTopics.length > 0 && (
    <div class="lab-card__topics">
      <p>연구·인턴 주제</p>
      <ul>
        {lab.internTopics.slice(0, 4).map((topic) => (
          <li class:list={{ matched: isHit(topic) }}>{topic}</li>
        ))}
      </ul>
    </div>
  )}
  {topic && topicTags.length > 0 && (
    <div class="lab-card__topics">
      <p>분야·지원 조건</p>
      <ul>{topicTags.map((tag) => <li class:list={{ matched: isHit(tag) }}>{tag}</li>)}</ul>
    </div>
  )}

  <div class="lab-card__actions">
    {opening && (
      <a class="lab-card__apply" href={withBase(`/apply/#opening-${opening.id}`)}>
        모집 공고 보기 <span aria-hidden="true">→</span>
      </a>
    )}
    {lab?.homepage && (
      <a href={lab.homepage} target="_blank" rel="noopener">
        연구실 홈페이지 <span class="visually-hidden">(새 탭)</span>
      </a>
    )}
    {topic?.url && (
      <a class="lab-card__apply" href={topic.url} target="_blank" rel="noopener">
        원문 공고 <span aria-hidden="true">↗</span><span class="visually-hidden">(새 탭)</span>
      </a>
    )}
  </div>
</article>

<style>
  .lab-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--muted) 28%, transparent);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--bg) 94%, var(--fg));
  }

  .lab-card[hidden] {
    display: none;
  }

  .lab-card__top,
  .lab-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .lab-card__dept,
  .lab-card__topics > p {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .lab-card__match {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-size: 0.75rem;
  }

  h3 {
    margin-top: 1rem;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
  }

  .lab-card__professor {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .lab-card__summary {
    margin-top: 1rem;
    line-height: 1.65;
  }

  .lab-card__summary.matched {
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .lab-card__topics {
    margin-top: 1.25rem;
  }

  .lab-card__topics ul {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lab-card__topics li {
    padding: 0.3rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--muted) 28%, transparent);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .lab-card__topics li.matched {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
  }

  .lab-card__actions {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.875rem;
  }

  .lab-card__actions a {
    color: var(--muted);
  }

  .lab-card__actions a:hover {
    color: var(--fg);
  }

  .lab-card__actions .lab-card__apply {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lab-card {
      transition: border-color 160ms ease-out, transform 160ms ease-out;
    }

    .lab-card:hover {
      border-color: color-mix(in srgb, var(--fg) 44%, transparent);
      transform: translateY(-2px);
    }
  }
</style>
