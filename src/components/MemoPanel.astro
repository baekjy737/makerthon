---
// 오른쪽 메모 패널. [data-memo-open] 버튼(data-id, data-title, data-type-label, data-path, data-files)을 누르면 열린다.
// 항목에 딸린 파일 목록을 보여 주고, 파일마다 메모를 따로 남긴다. 보내기는 모든 파일 메모를 이슈 하나로 묶는다.
// 스크림 없음: 패널이 열려 있어도 목록은 계속 조작할 수 있다.
interface Props {
  /** owner/name */
  repo: string;
}
const { repo } = Astro.props;
---

<aside class="memo" role="dialog" aria-modal="false" aria-labelledby="memo-title" data-memo-panel data-repo={repo} inert>
  <div class="memo-inner">
    <header class="memo-head">
      <div class="memo-meta">
        <p class="memo-type" data-memo-type></p>
        <h2 id="memo-title" data-memo-title></h2>
      </div>
      <div class="memo-tools">
        <button type="button" class="memo-icon" data-memo-full aria-pressed="false" aria-label="전체 화면으로 보기" title="전체 화면으로 보기">
          <svg class="i-expand" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="i-shrink" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 10h-6V4M4 14h6v6M14 10l7-7M10 14l-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" class="memo-icon" data-memo-close aria-label="메모 닫기" title="닫기">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="memo-body">
      <!-- 전체 화면일 때만 보이는 왼쪽 파일 미리보기 -->
      <section class="memo-preview" data-memo-preview aria-label="파일 미리보기"></section>

      <div class="memo-side">
        <section class="memo-files" aria-labelledby="memo-files-label">
          <p class="memo-label" id="memo-files-label">파일 <span class="memo-count" data-memo-file-count></span></p>
          <ul class="file-list" data-memo-files></ul>
        </section>

        <label class="memo-label" for="memo-text" data-memo-text-label>메모</label>
        <textarea
          id="memo-text"
          class="memo-text"
          data-memo-text
          placeholder="이 파일에 대해 떠오른 내용, 고칠 점, 자소서에 쓸 만한 에피소드 등을 적어 두세요."
          aria-describedby="memo-status"></textarea>

        <p class="memo-status" id="memo-status" data-memo-status aria-live="polite"></p>
        <p class="memo-warn" data-memo-warn hidden>이 브라우저에는 저장할 수 없어요. 보내기 전에 내용을 복사해 두세요.</p>

        <div class="memo-foot">
          <button type="button" class="memo-send" data-memo-send>메모 모아서 AI에게 보내기</button>
          <p class="memo-hint">파일별 메모를 이슈 하나로 묶어 GitHub 작성 화면을 새 탭으로 열어요. 제출하면 AI가 정리해서 이 항목에 반영해요.</p>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  import { animate, type AnimationPlaybackControls } from 'motion';
  import { issueUrl, TRUNCATED_NOTE } from '../lib/issue';
  import { fileMemoId, memoBody, memoStore, type MemoFile } from '../lib/memo';

  const panel = document.querySelector<HTMLElement>('[data-memo-panel]')!;
  const titleEl = panel.querySelector<HTMLElement>('[data-memo-title]')!;
  const typeEl = panel.querySelector<HTMLElement>('[data-memo-type]')!;
  const fileList = panel.querySelector<HTMLUListElement>('[data-memo-files]')!;
  const fileCount = panel.querySelector<HTMLElement>('[data-memo-file-count]')!;
  const textLabel = panel.querySelector<HTMLElement>('[data-memo-text-label]')!;
  const text = panel.querySelector<HTMLTextAreaElement>('[data-memo-text]')!;
  const status = panel.querySelector<HTMLElement>('[data-memo-status]')!;
  const warn = panel.querySelector<HTMLElement>('[data-memo-warn]')!;
  const send = panel.querySelector<HTMLButtonElement>('[data-memo-send]')!;
  const fullBtn = panel.querySelector<HTMLButtonElement>('[data-memo-full]')!;
  const preview = panel.querySelector<HTMLElement>('[data-memo-preview]')!;
  const repo = panel.dataset.repo!;

  // 시크릿 창 등에서는 localStorage 접근 자체가 throw할 수 있다
  let storage: Storage | null = null;
  try {
    storage = window.localStorage;
  } catch {
    storage = null;
  }
  const store = memoStore(storage);
  warn.hidden = store.ok;

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SPRING = { type: 'spring', bounce: 0, duration: 0.4 } as const;

  interface Current {
    id: string;
    title: string;
    path: string;
    files: MemoFile[];
    /** 파일 ref → 메모. 저장이 막힌 브라우저에서도 패널을 닫기 전까지는 여기 남는다 */
    notes: Map<string, string>;
    selected: number;
  }
  let current: Current | null = null;
  let trigger: HTMLButtonElement | null = null;
  let open = false;
  let anim: AnimationPlaybackControls | null = null;
  let saveTimer: number | undefined;
  let full = false;
  let fullAnim: AnimationPlaybackControls | null = null;

  const viewportWidth = () => document.documentElement.clientWidth || window.innerWidth;
  const compactWidth = () => Math.min(420, viewportWidth());

  /** 전체 화면 전환. 폭을 스프링으로 늘리고 줄인다(현재 폭에서 시작하므로 도중에 되돌려도 끊기지 않는다). */
  function setFull(on: boolean, instant = false) {
    full = on;
    panel.classList.toggle('is-full', on);
    fullBtn.setAttribute('aria-pressed', String(on));
    const label = on ? '작게 보기' : '전체 화면으로 보기';
    fullBtn.setAttribute('aria-label', label);
    fullBtn.title = label;
    fullAnim?.stop();
    const width = on ? viewportWidth() : compactWidth();
    fullAnim = animate(panel, { width }, instant || reduce.matches ? { duration: 0 } : SPRING);
    if (on) {
      renderPreview();
      if (!instant && !reduce.matches) animate(preview, { opacity: [0, 1] }, { duration: 0.25, delay: 0.08 });
    }
  }

  window.addEventListener('resize', () => {
    fullAnim?.stop();
    panel.style.width = `${full ? viewportWidth() : compactWidth()}px`;
  });

  const IMAGE_EXT = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'avif'];
  const extOf = (ref: string) => (ref.includes('.') ? ref.split('.').pop()!.toLowerCase() : '');

  /** 미리보기를 지원하지 않는 파일·외부 링크용 카드 */
  function previewCard(f: MemoFile, message: string) {
    const card = document.createElement('div');
    card.className = 'pv-card';
    const badge = document.createElement('span');
    badge.className = 'pv-card-badge';
    badge.textContent = badgeOf(f);
    const name = document.createElement('p');
    name.className = 'pv-card-name';
    name.textContent = f.label;
    const ref = document.createElement('p');
    ref.className = 'pv-card-ref';
    ref.textContent = f.ref;
    const msg = document.createElement('p');
    msg.className = 'pv-card-msg';
    msg.textContent = message;
    card.append(badge, name, ref, msg);
    if (f.href) {
      const a = document.createElement('a');
      a.className = 'pv-card-open';
      a.href = f.href;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = '새 탭에서 열기 ↗';
      card.append(a);
    }
    return card;
  }

  /** 왼쪽 미리보기. 전체 화면일 때만 그린다. 같은 파일이면 다시 그리지 않는다(PDF가 처음으로 돌아가지 않게). */
  function renderPreview() {
    if (!full || !current) return;
    const f = current.files[current.selected];
    const key = `${current.id}|${f.ref}`;
    if (preview.dataset.key === key) return;
    preview.dataset.key = key;
    preview.replaceChildren();

    if (f.kind === 'entry') {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-entry-preview="${CSS.escape(current.id)}"]`);
      if (tpl) {
        const doc = document.createElement('article');
        doc.className = 'pv-doc';
        doc.append(tpl.content.cloneNode(true));
        preview.append(doc);
      } else {
        preview.append(previewCard(f, '본문을 불러오지 못했어요.'));
      }
    } else if (f.kind === 'file' && f.href && IMAGE_EXT.includes(extOf(f.ref))) {
      const wrap = document.createElement('div');
      wrap.className = 'pv-media';
      const img = document.createElement('img');
      img.src = f.href;
      img.alt = f.label;
      img.decoding = 'async';
      wrap.append(img);
      preview.append(wrap);
    } else if (f.kind === 'file' && f.href && extOf(f.ref) === 'pdf') {
      const frame = document.createElement('iframe');
      frame.className = 'pv-frame';
      frame.src = f.href;
      frame.title = `${f.label} 미리보기`;
      preview.append(frame);
    } else if (f.kind === 'link') {
      preview.append(previewCard(f, '외부 사이트는 여기서 미리 볼 수 없어요. 새 탭에서 열어 확인해 주세요.'));
    } else {
      preview.append(previewCard(f, '이 형식은 미리 볼 수 없어요.'));
    }
  }

  // 닫힌 위치를 motion에 먼저 알려 두면, 이후 애니메이션은 항상 현재 화면 위치에서 시작한다(중간에 방향 전환 가능).
  animate(panel, { x: '100%', opacity: 1 }, { duration: 0 });

  const parseFiles = (btn: HTMLElement): MemoFile[] => {
    try {
      return JSON.parse(btn.dataset.files ?? '[]');
    } catch {
      return [];
    }
  };

  function badgeOf(f: MemoFile): string {
    if (f.kind === 'entry') return 'MD';
    if (f.kind === 'link') return 'LINK';
    const ext = f.ref.split('.').pop()?.toLowerCase() ?? '';
    if (ext === 'pdf') return 'PDF';
    if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'avif'].includes(ext)) return 'IMG';
    return ext ? ext.slice(0, 4).toUpperCase() : 'FILE';
  }

  function rowFor(id: string) {
    return document.querySelector<HTMLButtonElement>(`[data-memo-open][data-id="${CSS.escape(id)}"]`);
  }

  /** 항목 버튼의 점: 파일 메모가 하나라도 있으면 표시 */
  function refreshRowDot(btn: HTMLButtonElement, notes?: Map<string, string>) {
    const dot = btn.querySelector<HTMLElement>('[data-memo-dot]');
    if (!dot) return;
    const id = btn.dataset.id!;
    const has = parseFiles(btn).some((f) => (notes?.get(f.ref) ?? store.get(fileMemoId(id, f))).trim() !== '');
    dot.hidden = !has;
  }

  const filledCount = () => (current ? [...current.notes.values()].filter((t) => t.trim() !== '').length : 0);

  function updateSend() {
    const n = filledCount();
    send.disabled = n === 0;
    send.textContent = n > 0 ? `메모 ${n}개 모아서 AI에게 보내기` : '메모 모아서 AI에게 보내기';
  }

  function renderFiles() {
    if (!current) return;
    fileList.replaceChildren();
    fileCount.textContent = String(current.files.length);
    current.files.forEach((f, i) => {
      const li = document.createElement('li');
      const pick = document.createElement('button');
      pick.type = 'button';
      pick.className = 'file';
      pick.setAttribute('aria-pressed', String(i === current!.selected));
      pick.dataset.index = String(i);

      const badge = document.createElement('span');
      badge.className = 'file-badge';
      badge.textContent = badgeOf(f);
      const name = document.createElement('span');
      name.className = 'file-name';
      name.textContent = f.label;
      name.title = f.ref;
      const dot = document.createElement('span');
      dot.className = 'file-dot';
      dot.hidden = (current!.notes.get(f.ref) ?? '').trim() === '';
      dot.setAttribute('aria-label', '메모 있음');
      pick.append(badge, name, dot);
      li.append(pick);

      if (f.href) {
        const a = document.createElement('a');
        a.className = 'file-open';
        a.href = f.href;
        a.target = '_blank';
        a.rel = 'noopener';
        a.setAttribute('aria-label', `${f.label} 새 탭에서 열기`);
        a.textContent = '↗';
        li.append(a);
      }
      fileList.append(li);
    });
  }

  /** save=false: 방금 load()한 항목처럼 textarea가 아직 이 항목 내용이 아닐 때. 저장하면 남의 메모로 덮어쓴다 */
  function selectFile(i: number, focus = true, save = true) {
    if (!current) return;
    if (save) flush();
    current.selected = i;
    const f = current.files[i];
    text.value = current.notes.get(f.ref) ?? '';
    textLabel.textContent = `${f.label} 메모`;
    fileList.querySelectorAll<HTMLButtonElement>('.file').forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
    status.textContent = '';
    renderPreview();
    if (focus) text.focus({ preventScroll: true });
  }

  function flush() {
    window.clearTimeout(saveTimer);
    saveTimer = undefined;
    if (!current) return;
    const f = current.files[current.selected];
    if (!f) return;
    current.notes.set(f.ref, text.value);
    store.set(fileMemoId(current.id, f), text.value);
    const dot = fileList.querySelector<HTMLElement>(`.file[data-index="${current.selected}"] .file-dot`);
    if (dot) dot.hidden = text.value.trim() === '';
    if (trigger) refreshRowDot(trigger, current.notes);
    if (store.ok) status.textContent = text.value ? '이 브라우저에 저장됐어요' : '';
  }

  function load(btn: HTMLButtonElement) {
    if (current) flush();
    const id = btn.dataset.id!;
    const files = parseFiles(btn);
    if (files.length === 0) files.push({ ref: btn.dataset.path!, label: '항목 본문', kind: 'entry' });
    current = {
      id,
      title: btn.dataset.title!,
      path: btn.dataset.path!,
      files,
      notes: new Map(files.map((f) => [f.ref, store.get(fileMemoId(id, f))])),
      selected: 0,
    };
    titleEl.textContent = current.title;
    typeEl.textContent = btn.dataset.typeLabel ?? '';
    renderFiles();
    trigger?.setAttribute('aria-expanded', 'false');
    trigger = btn;
    btn.setAttribute('aria-expanded', 'true');
    selectFile(0, false, false);
    updateSend();
  }

  function show() {
    open = true;
    panel.inert = false;
    panel.classList.add('is-open');
    anim?.stop();
    anim = reduce.matches
      ? animate(panel, { x: 0, opacity: [0, 1] }, { duration: 0.2, x: { duration: 0 } })
      : animate(panel, { x: 0, opacity: 1 }, SPRING);
    text.focus({ preventScroll: true });
  }

  function hide() {
    if (!open) return;
    flush();
    open = false;
    panel.inert = true;
    trigger?.setAttribute('aria-expanded', 'false');
    anim?.stop();
    anim = reduce.matches
      ? animate(panel, { opacity: 0 }, { duration: 0.2 })
      : animate(panel, { x: '100%' }, SPRING);
    anim.then(() => {
      // 그 사이 다시 열렸으면 건드리지 않는다
      if (!open) {
        panel.classList.remove('is-open');
        animate(panel, { x: '100%', opacity: 1 }, { duration: 0 });
        // 다음에 열 때는 다시 작은 패널로
        if (full) setFull(false, true);
      }
    });
    trigger?.focus({ preventScroll: true });
  }

  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-memo-open]');
    if (!btn) return;
    if (open && current?.id === btn.dataset.id) {
      hide();
      return;
    }
    load(btn);
    show();
  });

  fileList.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.file');
    if (b) selectFile(Number(b.dataset.index));
  });

  panel.querySelector('[data-memo-close]')!.addEventListener('click', hide);
  fullBtn.addEventListener('click', () => setFull(!full));

  // Esc: 전체 화면이면 먼저 작은 패널로, 아니면 닫기
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape' || !open) return;
    ev.preventDefault();
    if (full) {
      setFull(false);
      fullBtn.focus({ preventScroll: true });
    } else hide();
  });

  text.addEventListener('input', () => {
    if (current) current.notes.set(current.files[current.selected].ref, text.value);
    updateSend();
    status.textContent = '';
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(flush, 300);
  });

  send.addEventListener('click', () => {
    if (!current) return;
    flush();
    const notes = current.files.map((f) => ({ label: f.label, ref: f.ref, text: current!.notes.get(f.ref) ?? '' }));
    const body = memoBody(current.path, notes);
    const url = issueUrl(repo, { label: 'memo', title: `[메모] ${current.title}`, body });
    const cut = url.endsWith(encodeURIComponent(TRUNCATED_NOTE)) && !body.endsWith(TRUNCATED_NOTE);
    window.open(url, '_blank', 'noopener');
    status.textContent = cut
      ? '메모가 길어서 앞부분만 담았어요. 열린 이슈에 나머지를 붙여 넣어 주세요.'
      : `메모 ${filledCount()}개를 담았어요. GitHub에서 이슈를 제출하면 AI가 정리해요.`;
  });

  // 페이지를 떠나기 직전 디바운스 중인 내용을 저장
  window.addEventListener('pagehide', flush);

  // 저장된 메모가 있는 항목에 점 표시
  if (store.ok) document.querySelectorAll<HTMLButtonElement>('[data-memo-open]').forEach((b) => refreshRowDot(b));
</script>

<style>
  .memo {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    width: min(420px, 100vw);
    visibility: hidden;
    transform: translateX(100%);
    will-change: transform;
  }
  .memo.is-open {
    visibility: visible;
  }

  /* 막지 않는 평행 패널: 스크림 없이 반투명 재질 + 그림자로 띄운다 */
  .memo-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: max(1.25rem, env(safe-area-inset-top)) 1.5rem max(1.25rem, env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    border-left: 1px solid color-mix(in srgb, var(--fg) 10%, transparent);
    box-shadow: -24px 0 60px -20px rgb(0 0 0 / 0.55);
  }

  .memo-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .memo-meta {
    min-width: 0;
  }
  .memo-type {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.375rem;
  }
  .memo-head h2 {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .memo-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    cursor: pointer;
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out;
  }
  .memo-icon:hover {
    background: color-mix(in srgb, var(--fg) 14%, transparent);
  }
  .memo-icon:active {
    transform: scale(0.94);
  }

  .memo-label {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .memo-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-left: 0.25rem;
  }

  /* 파일 목록 */
  .memo-files {
    margin-bottom: 1.25rem;
  }
  .file-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem;
    max-height: 13rem;
    overflow-y: auto;
    border-radius: 12px;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }
  .file-list :global(li) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .file-list :global(.file) {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.5rem;
    padding: 0 0.625rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition:
