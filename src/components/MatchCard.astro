---
// "관심 분야와 맞는 기회" 카드(연구실·기업·인턴). 근거 기록 중 공개 항목이 하나도 없으면 아무것도 그리지 않는다.
// 인턴 모집 배지는 빌드 날짜로 먼저 그리고, 브라우저에서 오늘 날짜로 다시 계산한다.
import type { CollectionEntry } from 'astro:content';
import PlanButton from './PlanButton.astro';
import { findTarget, interns } from '../lib/data';
import { recruitStatus, resolveFrom } from '../lib/recommend';
import { withBase } from '../lib/url';

interface Props {
  item: CollectionEntry<'matches'>;
  entries: CollectionEntry<'entries'>[];
}

const KIND_LABELS = { lab: '연구실', company: '기업', intern: '인턴' } as const;

const { item, entries } = Astro.props;
const { data } = item;
const from = resolveFrom(data.from, entries);
const target = findTarget(data.kind, data.target);
const title = target?.title ?? data.target;
const href = withBase(`match/${item.id}/`);
const intern = data.kind === 'intern' ? interns.find((i) => i.id === data.target) : undefined;
const recruit = intern ? { start: intern.start ?? '', deadline: intern.deadline ?? '', url: intern.url ?? '' } : undefined;
const builtStatus = intern ? recruitStatus({ start: intern.start, deadline: intern.deadline, url: intern.url }, new Date()) : undefined;
---

{
  from.length > 0 && (
    <article class="rc lift-card" data-plan-item={`match:${item.id}`}>
      <div class="rc-top">
        <p class="rc-eyebrow">{KIND_LABELS[data.kind]}</p>
        <p class="score" aria-label={`적합도 ${data.score}점`}>
          <span class="score-n">{data.score}</span>
          <span class="score-bar" aria-hidden="true">
            <span style={`width:${data.score}%`} />
          </span>
        </p>
      </div>

      <h3 class="rc-title">
        <a href={href}>{title}</a>
      </h3>

      {recruit && (
        <p class="recruit">
          <span
            class="badge"
            data-recruit
            data-start={recruit.start}
            data-deadline={recruit.deadline}
            data-url={recruit.url}
            data-state={builtStatus}
          >
            {builtStatus}
          </span>
          {intern?.deadline && <span class="recruit-date">마감 {intern.deadline}</span>}
        </p>
      )}

      <p class="rc-reason">{data.reason}</p>

      <div class="rc-from">
        <span class="rc-k">출발한 기록</span>
        <ul>
          {from.map((e) => (
            <li>
              <a href={withBase(`portfolio/${e.id}/`)}>{e.data.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="rc-foot">
        <PlanButton id={`match:${item.id}`} />
        <a class="rc-more" href={href}>
          자세히 <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  )
}

<script>
  import { recruitStatus } from '../lib/recommend';

  const today = new Date();
  document.querySelectorAll<HTMLElement>('[data-recruit]').forEach((el) => {
    const { start, deadline, url } = el.dataset;
    el.textContent = recruitStatus({ start: start || undefined, deadline: deadline || undefined, url: url || undefined }, today);
    el.dataset.state = el.textContent;
  });
</script>

<style>
  .rc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.25rem;
  }
  .rc[hidden] {
    display: none;
  }
  .rc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .rc-eyebrow {
    font-family: var(--font-ko-bold);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .score-n {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .score-bar {
    position: relative;
    width: 3.5rem;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--fg) 12%, transparent);
    overflow: hidden;
  }
  .score-bar > span {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 2px;
    background: var(--accent);
  }
  .rc-title {
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-top: -0.5rem;
  }
  .rc-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .recruit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.25rem;
  }
  .badge {
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
    color: var(--muted);
  }
  .badge[data-state='모집 중'] {
    border-color: #22c55e;
    color: #4ade80;
  }
  .badge[data-state='모집 예정'] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .recruit-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .rc-reason {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--fg) 86%, var(--muted));
  }

  .rc-k {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.375rem;
  }
  .rc-from ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rc-from li a {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    font-size: 0.8125rem;
    transition: border-color 160ms ease-out;
  }
  .rc-from li a:hover {
    border-color: color-mix(in srgb, var(--fg) 40%, transparent);
  }

  .rc-foot {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .rc-more {
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 160ms ease-out;
  }
  .rc-more:hover {
    color: var(--fg);
  }
</style>
