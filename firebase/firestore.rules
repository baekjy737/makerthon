rules_version = '2';

// 브라우저(웹 SDK)는 공개 콘텐츠만 읽는다. 모든 쓰기와 요청 대화(requests)는 서버(firebase-admin)만 다룬다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 활동 기록: 공개 항목만. 목록 질의도 where('public', '==', true)가 있어야 통과한다
    match /entries/{id} {
      allow read: if resource.data.public == true;
    }
    // 지원 건·자소서·추천·공고는 지금처럼 사이트에 공개된다
    match /applications/{id} { allow read: if true; }
    match /essays/{id} { allow read: if true; }
    match /next/{id} { allow read: if true; }
    match /matches/{id} { allow read: if true; }
    match /openings/{id} { allow read: if true; }
    // 메인 프로필 사진 주소(site/profile.photo). 쓰기는 /api/profile/photo(서버)만
    match /site/{id} { allow read: if true; }
    // 그 밖(requests 등)은 규칙이 없으므로 모두 거부된다
  }
}
